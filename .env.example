# NVIDIA_API_KEY: Dedicated API key for NVIDIA NIM API (Llama 3.2 11B Vision Instruct, Nemotron).
# Used exclusively for all Mithra AI generation, exam formulation, and interactive chat.
NVIDIA_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

